"""
Apply pages 28-34 patches to MercyBlade source files.
Run from /Users/admin/MercyB:
    python3 ~/Downloads/apply_patches.py
"""
import sys, os

BASE = os.path.dirname(os.path.abspath(__file__)) if '__file__' in dir() else os.getcwd()
# When run from MercyB root, use relative paths
# When run from Downloads, auto-detect

def patch_file(rel_path, replacements):
    candidates = [
        os.path.join('/Users/admin/MercyB', rel_path),
        os.path.join(os.getcwd(), rel_path),
    ]
    path = next((p for p in candidates if os.path.exists(p)), None)
    if not path:
        print(f"  ✗ NOT FOUND: {rel_path}")
        return False
    with open(path, 'r', encoding='utf-8') as f:
        src = f.read()
    original = src
    for find, replace in replacements:
        if find not in src:
            print(f"  ⚠  Pattern not found (already patched?): {find[:60]!r}")
            continue
        src = src.replace(find, replace, 1)
    if src == original:
        print(f"  ~ No changes needed: {rel_path}")
        return True
    with open(path, 'w', encoding='utf-8') as f:
        f.write(src)
    print(f"  ✓ Patched: {rel_path}")
    return True

