// --- UTILITIES ---

function canUseStorage() {
  return typeof window !== 'undefined' && typeof window.localStorage !== 'undefined';
}

function cleanText(value?: string | null) {
  return String(value ?? '').replace(/\s+/g, ' ').trim();
}

function makeId() {
  return `mgr_${Math.random().toString(36).slice(2, 10)}_${Date.now().toString(36)}`;
}

function normalizeSeed(seed: MercyGuideReplySeed): MercyGuideReplyRecord {
  return {
    id: makeId(),
    intent: seed.intent,
    language: seed.language,
    userInput: cleanText(seed.userInput),
    payload: cleanText(seed.payload),
    roomId: cleanText(seed.roomId),
    roomTitle: cleanText(seed.roomTitle),
    tier: cleanText(seed.tier),
    pathSlug: cleanText(seed.pathSlug),
    tags: (seed.tags ?? []).map(cleanText).filter(Boolean),
    englishLevel: cleanText(seed.englishLevel),
    learningGoal: cleanText(seed.learningGoal),
    reply: String(seed.reply ?? '').trim(),
    source: seed.source,
    createdAt: new Date().toISOString(),
    approved: Boolean(seed.approved),
    notes: cleanText(seed.notes),
  };
}

// --- CORE FUNCTIONS ---

export function getMercyGuideReplyLibrary(): MercyGuideReplyRecord[] {
  if (!canUseStorage()) return [];

  try {
    const raw = window.localStorage.getItem(STORAGE_KEY);
    if (!raw) {
      const seeded = INITIAL_TEACHER_SEEDS.map(normalizeSeed);
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(seeded));
      return seeded;
    }

    const parsed = JSON.parse(raw) as MercyGuideReplyRecord[];
    if (!Array.isArray(parsed)) return [];

    return parsed
      .filter((item) => item && typeof item.reply === 'string')
      .sort((a, b) => (a.createdAt < b.createdAt ? 1 : -1));
  } catch {
    return [];
  }
}

export function saveMercyGuideReplyRecord(
  seed: MercyGuideReplySeed
): MercyGuideReplyRecord | null {
  if (!canUseStorage()) return null;

  const next = normalizeSeed(seed);
  const existing = getMercyGuideReplyLibrary();
  const updated = [next, ...existing].slice(0, MAX_RECORDS);

  try {
    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
    return next;
  } catch {
    return null;
  }
}

export function updateMercyGuideReplyRecord(
  id: string,
  patch: Partial<Pick<MercyGuideReplyRecord, 'approved' | 'notes' | 'intent'>>
): MercyGuideReplyRecord[] {
  if (!canUseStorage()) return [];

  const existing = getMercyGuideReplyLibrary();
  const updated = existing.map((item) =>
    item.id === id
      ? {
          ...item,
          approved: typeof patch.approved === 'boolean' ? patch.approved : item.approved,
          notes: typeof patch.notes === 'string' ? cleanText(patch.notes) : item.notes,
          intent: patch.intent ?? item.intent,
        }
      : item
  );

  try {
    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
    return updated;
  } catch {
    return existing;
  }
}

export function deleteMercyGuideReplyRecord(id: string): MercyGuideReplyRecord[] {
  if (!canUseStorage()) return [];

  const existing = getMercyGuideReplyLibrary();
  const updated = existing.filter((item) => item.id !== id);

  try {
    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
    return updated;
  } catch {
    return existing;
  }
}

export function clearMercyGuideReplyLibrary() {
  if (!canUseStorage()) return;
  try {
    window.localStorage.removeItem(STORAGE_KEY);
  } catch {
    // no-op
  }
}

export function findApprovedMercyGuideReplies(
  intent: MercyGuideReplyIntent,
  language?: 'vi' | 'en'
): MercyGuideReplyRecord[] {
  const library = getMercyGuideReplyLibrary();
  let matches = library.filter((item) => {
    if (!item.approved) return false;
    if (item.intent !== intent) return false;
    if (language && item.language !== language) return false;
    return true;
  });

  if (matches.length === 0 && intent !== 'fallback') {
    return library.filter(item => item.intent === 'fallback' && item.approved);
  }

  return matches;
}

export function buildMercyGuideReplyExport() {
  const rows = getMercyGuideReplyLibrary();

  return rows.map((item) => ({
    id: item.id,
    intent: item.intent,
    language: item.language,
    userInput: item.userInput,
    payload: item.payload || '',
    reply: item.reply,
    source: item.source,
    approved: Boolean(item.approved),
    createdAt: item.createdAt,
    notes: item.notes || '',
    roomTitle: item.roomTitle || '',
    tier: item.tier || '',
    pathSlug: item.pathSlug || '',
    englishLevel: item.englishLevel || '',
    learningGoal: item.learningGoal || '',
    tags: (item.tags ?? []).join(', '),
  }));
}

