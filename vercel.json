{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mercy/grammar.ts": {
      "maxDuration": 30
    },
    "api/tts.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/mercy/grammar",
      "dest": "/api/mercy/grammar.ts"
    },
    {
      "src": "/api/tts",
      "dest": "/api/tts.ts"
    },
    {
      "src": "/about/chau",
      "status": 302,
      "headers": { "Location": "/" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}