{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mercy/grammar.ts": {
      "maxDuration": 30
    },
    "api/tts.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/about/chau",
      "destination": "/",
      "statusCode": 302
    }
  ],
  "rewrites": [
    { "source": "/api/tts", "destination": "/api/tts" },
    { "source": "/api/mercy/grammar", "destination": "/api/mercy/grammar" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
