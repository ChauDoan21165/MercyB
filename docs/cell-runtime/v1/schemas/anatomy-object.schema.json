{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercyb.local/schemas/cell-runtime-v1/anatomy-object.schema.json",
  "title": "MercyB Anatomy Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anatomy_id",
    "source_id",
    "source_type",
    "anatomy_layer",
    "canonical_type",
    "source_system",
    "source_location",
    "confidence",
    "reason"
  ],
  "properties": {
    "anatomy_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "anatomy_layer": {
      "type": "string",
      "enum": ["SYSTEM", "ORGAN", "TISSUE", "CELL", "RESOURCE", "TEMPORARY", "MEASUREMENT", "DIAGNOSTIC", "UNKNOWN"]
    },
    "canonical_type": { "type": "string", "minLength": 1 },
    "parent_anatomy_id": { "type": "string" },
    "owner_id": { "type": "string" },
    "source_system": { "type": "string", "minLength": 1 },
    "source_location": { "type": "string" },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]
    },
    "reason": { "type": "string", "minLength": 1 }
  }
}
