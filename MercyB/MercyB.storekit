<?xml version="1.0" encoding="UTF-8"?>
<slot machine="0">
    <products>
        <product id="com.mercyblade.premium" type="autoRenewableSubscription">
            <group id="PremiumAccess">
                <subscription periodicity="monthly" unit="month">
                    <price locale="en_US">9.99</price>
                    <displayNames>
                        <displayName locale="en_US">MercyB Premium</displayName>
                    </displayNames>
                    <descriptions>
                        <description locale="en_US">Full access to the Teacher and Guide personas, advanced pronunciation feedback, and unlimited chat.</description>
                    </descriptions>
                    <offer id="premium_trial" type="introductory">
                        <displayNames>
                            <displayName locale="en_US">7-Day Free Trial</displayName>
                        </displayNames>
                        <duration unit="day">7</duration>
                        <price locale="en_US">0.00</price>
                    </offer>
                </subscription>
            </group>
        </product>
    </products>
    <settings>
        <remoteProductVerification enabled="false"/>
        <disableDialogs enabled="false"/>
        <enableAutoTermination enabled="true"/>
        <billingGracePeriod enabled="true"/>
        <interruptedPurchases enabled="true"/>
        <subscriptionTimeRate>
            <rate unit="month" seconds="300"/> </subscriptionTimeRate>
    </settings>
</slot>