# ──────────────────────────────────────────────────────────────────────────────
# Mercy Blade — Environment Variables (IAP subset)
# ──────────────────────────────────────────────────────────────────────────────
#
# This file documents the environment variables the Apple In-App Purchase
# track introduced. Other Vite env vars (Supabase URL, anon key, Stripe
# price IDs, analytics keys, etc.) belong to other tracks and are not
# catalogued here. Treat this as additive — copy the relevant rows into
# your own .env.local / deployment env.
#
# Convention:
#   VITE_*      → exposed to the browser bundle (must be non-secret).
#   REVENUECAT_*→ server-only; set via `supabase secrets set` (never
#                 prefixed VITE_).
#
# ──────────────────────────────────────────────────────────────────────────────
# Apple In-App Purchase (iOS only)
# ──────────────────────────────────────────────────────────────────────────────

# RevenueCat iOS SDK public key. Safe to ship in the iOS bundle; RevenueCat
# designed this key to live in client code. Not needed on web or Android.
#
# Where to find: RevenueCat Dashboard → Project → API Keys → Apple App Store.
# Two flavors exist ("appl_…" = production, "test_…" = sandbox/TestFlight);
# you can use either value — RevenueCat routes based on the receipt type.
#
# If missing at runtime on iOS: initRevenueCat() logs a warning and
# IapPlanCard renders a "not configured" state. App does NOT crash.
VITE_REVENUECAT_APPLE_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# RevenueCat → Supabase webhook (server-side only; DO NOT prefix VITE_)
# ──────────────────────────────────────────────────────────────────────────────

# Shared secret for the revenuecat-webhook edge function. Set the same value
# in RevenueCat Dashboard → Integrations → Webhook → Authorization header,
# AND in Supabase Edge Function secrets with the command below.
#
# Generate a fresh token locally:
#   openssl rand -hex 32
#
# Apply as a Supabase secret:
#   npx supabase secrets set REVENUECAT_WEBHOOK_AUTH_TOKEN=<value> \
#     --project-ref buemdfxyhxunzpgdoqin
#
# Then paste the same <value> into RevenueCat's Authorization field.
# The webhook handler accepts either the bare token or "Bearer <token>",
# so either format works in the dashboard.
REVENUECAT_WEBHOOK_AUTH_TOKEN=

# Optional kill switch for the webhook. Set this to the literal string
# "true" to make revenuecat-webhook return 200 without writing anything
# to the DB. Useful if the webhook is emitting bad data and you need
# to freeze writes WITHOUT redeploying the function.
#
# Apply:
#   npx supabase secrets set REVENUECAT_WEBHOOK_DISABLED=true \
#     --project-ref buemdfxyhxunzpgdoqin
#
# Unset (re-enable):
#   npx supabase secrets unset REVENUECAT_WEBHOOK_DISABLED \
#     --project-ref buemdfxyhxunzpgdoqin
REVENUECAT_WEBHOOK_DISABLED=

# ──────────────────────────────────────────────────────────────────────────────
# Sentry — error & crash reporting (web + iOS + Android via @sentry/capacitor)
# ──────────────────────────────────────────────────────────────────────────────

# DSN for the Sentry project that ingests web JS errors, native iOS crashes,
# and native Android crashes. The DSN is a client-side credential designed
# to be public in the bundle, but we still source it from env so it can be
# rotated without a code change.
#
# Activation model:
#   - Empty value → Sentry is fully no-op. The @sentry/capacitor + @sentry/react
#     SDKs are dynamically imported only when this is set, so an unset DSN
#     keeps the bundle clean (zero KB of Sentry shipped).
#   - Set in Vercel project env vars (production scope only). Do not commit
#     the real value here.
#
# Where to find: Sentry Dashboard → Settings → Client Keys (DSN).
VITE_SENTRY_DSN=

# ──────────────────────────────────────────────────────────────────────────────
# Zalo AI — Vietnamese TTS (local script only, not used at runtime)
# ──────────────────────────────────────────────────────────────────────────────

# API key for Zalo AI TTS, used by scripts/generate-vietnamese-audio.ts
# to generate A2-C2 audio clips and upload them to Supabase Storage.
#
# Server-side / local-only secret. NEVER prefix with VITE_ — this must not
# ship in the browser bundle.
#
# Where to find: https://ai.zalo.solutions → API Keys.
# Speakers: 2 = female Northern, 4 = male Northern.
ZALO_API_KEY=
