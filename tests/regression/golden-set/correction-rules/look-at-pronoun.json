{
  "rule": "step6LookAtPronoun",
  "ruleId": "en-step6-look-at-pronoun",
  "language": "en",
  "description": "Adds 'at' after look only for high-confidence pronoun-object surfaces.",
  "fp_risk_note": "High risk. Look can be a linking verb or part of many phrasal verbs, including separated phrasal verbs. V1 is pronoun-object only and blocks adjective complements, particles, and separated phrasal-verb surfaces.",
  "positive": [
    {
      "id": "look-at-pronoun-pos-001",
      "input": "Look me.",
      "expectedStatus": "corrected",
      "expectedCorrection": "Look at me.",
      "expectedRuleFired": "step6LookAtPronoun",
      "notes": "Bare look plus object pronoun me takes 'at'."
    },
    {
      "id": "look-at-pronoun-pos-002",
      "input": "She looked him.",
      "expectedStatus": "corrected",
      "expectedCorrection": "She looked at him.",
      "expectedRuleFired": "step6LookAtPronoun",
      "notes": "Past-tense looked plus object pronoun him takes 'at'."
    },
    {
      "id": "look-at-pronoun-pos-003",
      "input": "They are looking us.",
      "expectedStatus": "corrected",
      "expectedCorrection": "They are looking at us.",
      "expectedRuleFired": "step6LookAtPronoun",
      "notes": "Progressive looking plus object pronoun us takes 'at'."
    }
  ],
  "negative": [
    {
      "id": "look-at-pronoun-neg-001",
      "input": "She looks happy.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "She looks happy.",
      "expectedRuleFired": null,
      "notes": "Linking-verb look with adjective complement must not become look at."
    },
    {
      "id": "look-at-pronoun-neg-002",
      "input": "I look for my phone.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "I look for my phone.",
      "expectedRuleFired": null,
      "notes": "Phrasal verb look for is already complete."
    },
    {
      "id": "look-at-pronoun-neg-003",
      "input": "He looks like his father.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "He looks like his father.",
      "expectedRuleFired": null,
      "notes": "Look like is a blocked particle surface."
    },
    {
      "id": "look-at-pronoun-neg-004",
      "input": "Look at me.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "Look at me.",
      "expectedRuleFired": null,
      "notes": "Already contains 'at'."
    },
    {
      "id": "look-at-pronoun-neg-005",
      "input": "I'll look you up.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "I'll look you up.",
      "expectedRuleFired": null,
      "notes": "Separated phrasal verb look up must not become look at you up."
    },
    {
      "id": "look-at-pronoun-neg-006",
      "input": "Look them over.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "Look them over.",
      "expectedRuleFired": null,
      "notes": "Separated phrasal verb look over must not become look at them over."
    },
    {
      "id": "look-at-pronoun-neg-007",
      "input": "Watch me.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "Watch me.",
      "expectedRuleFired": null,
      "notes": "FP guard (different verb): the rule targets 'look'; 'watch me' must not get 'at' inserted."
    },
    {
      "id": "look-at-pronoun-neg-008",
      "input": "Look it up.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "Look it up.",
      "expectedRuleFired": null,
      "notes": "FP guard (non-person pronoun + separated particle): 'it' is outside the person-object set {me,you,him,her,us,them}, and 'up' is a separated particle; rule abstains."
    },
    {
      "id": "look-at-pronoun-neg-009",
      "input": "They look down on us.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "They look down on us.",
      "expectedRuleFired": null,
      "notes": "FP guard ('look down on' phrasal): 'look' is not immediately followed by a person pronoun ('down' intervenes); rule abstains."
    }
  ]
}
