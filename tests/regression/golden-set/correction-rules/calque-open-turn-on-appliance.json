{
  "rule": "calqueOpenTurnOnAppliance",
  "ruleId": "en-calque-open-turn-on-appliance",
  "language": "en",
  "description": "Rewrites Vietnamese 'mo' calque open to turn on only for closed appliance/electrical direct objects.",
  "fp_risk_note": "High risk if object scope is broad. Open is correct for doors, windows, boxes, books, apps, laptops, computer cases, and many nouns. V1 only rewrites a closed appliance/electrical object whitelist and requires the whitelist token to be the direct-object head noun.",
  "positive": [
    {
      "id": "calque-open-turn-on-appliance-pos-001",
      "input": "Open the light.",
      "expectedStatus": "corrected",
      "expectedCorrection": "Turn on the light.",
      "expectedRuleFired": "calqueOpenTurnOnAppliance",
      "notes": "Light is a closed electrical object where English uses turn on."
    },
    {
      "id": "calque-open-turn-on-appliance-pos-002",
      "input": "Can you open the TV?",
      "expectedStatus": "corrected",
      "expectedCorrection": "Can you turn on the TV?",
      "expectedRuleFired": "calqueOpenTurnOnAppliance",
      "notes": "TV is a closed appliance object and the question frame is preserved."
    },
    {
      "id": "calque-open-turn-on-appliance-pos-003",
      "input": "I opened the fan.",
      "expectedStatus": "corrected",
      "expectedCorrection": "I turned on the fan.",
      "expectedRuleFired": "calqueOpenTurnOnAppliance",
      "notes": "Past opened maps to turned on for a whitelisted appliance object."
    }
  ],
  "negative": [
    {
      "id": "calque-open-turn-on-appliance-neg-001",
      "input": "Open the door.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "Open the door.",
      "expectedRuleFired": null,
      "notes": "Open is correct for doors."
    },
    {
      "id": "calque-open-turn-on-appliance-neg-002",
      "input": "Open the window.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "Open the window.",
      "expectedRuleFired": null,
      "notes": "Open is correct for windows."
    },
    {
      "id": "calque-open-turn-on-appliance-neg-003",
      "input": "Open the box.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "Open the box.",
      "expectedRuleFired": null,
      "notes": "Open is correct for boxes."
    },
    {
      "id": "calque-open-turn-on-appliance-neg-004",
      "input": "Open the laptop.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "Open the laptop.",
      "expectedRuleFired": null,
      "notes": "Laptop is explicitly excluded because open may mean open the lid."
    },
    {
      "id": "calque-open-turn-on-appliance-neg-005",
      "input": "Open the TV stand.",
      "expectedStatus": "unchanged",
      "expectedCorrection": "Open the TV stand.",
      "expectedRuleFired": null,
      "notes": "TV is not the direct-object head noun; stand is."
    }
  ]
}
