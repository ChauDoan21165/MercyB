{
  "rule": "step6AtClockTime",
  "ruleId": "en-step6-at-clock-time",
  "language": "en",
  "description": "Inserts at before explicit clock times after a small whitelist of time-taking verbs.",
  "fp_risk_note": "Low-medium risk. Only explicit clock-time formats should trigger; duration and vague time expressions must stay unchanged.",
  "positive": [
    {
      "id": "at-clock-time-pos-001",
      "input": "I wake up 7 o'clock.",
      "expectedCorrection": "I wake up at 7 o'clock.",
      "expectedRuleFired": "step6AtClockTime",
      "notes": "Inserts at before o'clock time."
    },
    {
      "id": "at-clock-time-pos-002",
      "input": "She starts work 8 AM.",
      "expectedCorrection": "She starts work at 8 AM.",
      "expectedRuleFired": "step6AtClockTime",
      "notes": "Inserts at before AM time."
    },
    {
      "id": "at-clock-time-pos-003",
      "input": "We meet 6:30.",
      "expectedCorrection": "We meet at 6:30.",
      "expectedRuleFired": "step6AtClockTime",
      "notes": "Inserts at before colon clock time."
    }
  ],
  "negative": [
    {
      "id": "at-clock-time-neg-001",
      "input": "I wake up early.",
      "expectedCorrection": "I wake up early.",
      "expectedRuleFired": null,
      "notes": "Vague time stays unchanged."
    },
    {
      "id": "at-clock-time-neg-002",
      "input": "She works 8 hours.",
      "expectedCorrection": "She works 8 hours.",
      "expectedRuleFired": null,
      "notes": "Duration stays unchanged."
    },
    {
      "id": "at-clock-time-neg-003",
      "input": "We meet tomorrow.",
      "expectedCorrection": "We meet tomorrow.",
      "expectedRuleFired": null,
      "notes": "Future adverb stays unchanged."
    },
    {
      "id": "at-clock-time-neg-004",
      "input": "We meet at 6:30.",
      "expectedCorrection": "We meet at 6:30.",
      "expectedRuleFired": null,
      "notes": "Already correct phrase stays unchanged."
    },
    {
      "id": "at-clock-time-neg-005",
      "input": "I arrive 7am.",
      "expectedCorrection": "I arrive 7am.",
      "expectedRuleFired": null,
      "notes": "FP guard (different verb): clock time present but 'arrive' is outside the whitelist {wake up, start work, meet}; rule abstains."
    },
    {
      "id": "at-clock-time-neg-006",
      "input": "I meet him 6:30.",
      "expectedCorrection": "I meet him 6:30.",
      "expectedRuleFired": null,
      "notes": "FP guard (intervening object): 'meet' is not immediately followed by the clock time ('him' intervenes), so no 'at' is inserted."
    },
    {
      "id": "at-clock-time-neg-007",
      "input": "When do we meet?",
      "expectedCorrection": "When do we meet?",
      "expectedRuleFired": null,
      "notes": "FP guard (question, no clock token): 'meet' with no following clock-time format; rule abstains."
    },
    {
      "id": "at-clock-time-neg-008",
      "input": "I have an 8 o'clock class.",
      "expectedCorrection": "I have an 8 o'clock class.",
      "expectedRuleFired": null,
      "notes": "FP guard (clock token as noun modifier): \"8 o'clock\" modifies 'class' and 'have' is outside the verb whitelist; rule abstains."
    }
  ]
}
